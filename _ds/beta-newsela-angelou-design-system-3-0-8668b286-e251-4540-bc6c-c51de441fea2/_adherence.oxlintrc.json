{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "a",
            "message": "Use <Link> from the design system instead of <a>."
          },
          {
            "element": "dialog",
            "message": "Use <Modal> from the design system instead of <dialog>."
          },
          {
            "element": "table",
            "message": "Use <Table> from the design system instead of <table>."
          },
          {
            "element": "input",
            "message": "Use <TextInput> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/components/AlertBanner/**",
              "components/components/ArticleCard/**",
              "components/components/Badge/**",
              "components/components/BarChartRow/**",
              "components/components/Button/**",
              "components/components/Chip/**",
              "components/components/Divider/**",
              "components/components/Icon/**",
              "components/components/InfoCard/**",
              "components/components/Link/**",
              "components/components/ListItem/**",
              "components/components/Modal/**",
              "components/components/Popout/**",
              "components/components/Table/**",
              "components/components/Tabs/**",
              "components/components/TextInput/**",
              "components/components/Toast/**",
              "components/components/Toggletip/**",
              "semantics/**",
              "semantics/lib/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Circular|Noto Serif))/i]",
        "message": "Font not provided by the design system. Available: Circular, Noto Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|bannerType|title|alignment|dismissable|onDismiss|focusAfterDismiss|standing|actions|children|className|id|style|key|ref|className|style|children)$/]",
        "message": "<AlertBanner> doesn't accept that prop. Declared props: status, bannerType, title, alignment, dismissable, onDismiss, focusAfterDismiss, standing, actions, children, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<AlertBanner> status must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute[name.name='bannerType'] > Literal[value!=/^(?:simple|compound)$/]",
        "message": "<AlertBanner> bannerType must be one of 'simple' | 'compound'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertBanner'] > JSXAttribute[name.name='alignment'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<AlertBanner> alignment must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|href|subject|date|levels|maturity|readingLevel|contentType|metaTag|cardType|showButtons|featureTag|showBadge|badgeColor|badgeStyle|badgeIcon|image|onOpen|onAssign|onBookmark|bookmarked|loading|className|id|style|key|ref|className|style|children)$/]",
        "message": "<ArticleCard> doesn't accept that prop. Declared props: title, href, subject, date, levels, maturity, readingLevel, contentType, metaTag, cardType, showButtons, featureTag, showBadge, badgeColor, badgeStyle, badgeIcon, image, onOpen, onAssign, onBookmark, bookmarked, loading, className, id, style."
      },
