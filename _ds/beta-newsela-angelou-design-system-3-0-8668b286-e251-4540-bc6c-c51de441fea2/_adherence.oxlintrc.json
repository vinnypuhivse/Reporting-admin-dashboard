        "message": "<ArticleCard> subject must be one of 'ELA' | 'Social Studies' | 'Science' | 'News'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleCard'] > JSXAttribute[name.name='contentType'] > Literal[value!=/^(?:News|Article|Video|Audio|Information|Fiction|Text set|Collection|Decodable)$/]",
        "message": "<ArticleCard> contentType must be one of 'News' | 'Article' | 'Video' | 'Audio' | 'Information' | 'Fiction' | 'Text set' | 'Collection' | 'Decodable'."
